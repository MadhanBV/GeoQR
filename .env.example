# Flask Application Secrets
SECRET_KEY=replace-with-a-random-secure-secret-key-32-chars-long
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# GeoQR Anti-Proxy Settings
QR_TOKEN_MAX_AGE_SECONDS=25

# Firebase Firestore Configuration
# Provide absolute path or relative to project root
FIREBASE_CREDENTIALS_PATH=firebase/serviceAccountKey.json
